# ============================================================================
# ArthaAI Production Environment Configuration Template
# Copy this file to .env and configure keys. Never commit real credentials!
# ============================================================================

# Environment Mode: development | production | test
ARTHAAI_ENVIRONMENT=production

# IMMUTABLE SAFETY LOCK: Live trading must strictly remain disabled (false)
ARTHAAI_LIVE_TRADING_ENABLED=false

# System Logging Level: DEBUG | INFO | WARNING | ERROR
ARTHAAI_LOG_LEVEL=INFO

# Data Root Directory (defaults to 'data' in container)
ARTHAAI_DATA_DIR=data

# Network & API Host Binding
ARTHAAI_API_HOST=0.0.0.0
ARTHAAI_API_PORT=8000
PORT=8000
HOST_PORT=80

# CORS Allowed Origins (comma-separated, or * for open/reverse-proxy deployments)
ARTHAAI_ALLOWED_ORIGINS=*

# Frontend API URL (leave blank for same-origin relative routing, or set public URL)
VITE_API_URL=

# ============================================================================
# Model Providers & LLM Credentials
# ============================================================================
# Google Gemini API Key (Recommended free tier: 15 RPM / 1M TPM free)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional secondary provider)
# Obtain from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Default Active LLM Provider: GEMINI | OPENAI
LLM_DEFAULT_PROVIDER=GEMINI

# Model Identifiers
LLM_GEMINI_MODEL=gemini-3.1-flash-lite
LLM_OPENAI_MODEL=gpt-4o-mini

# Execution Guardrails & Budget Caps
LLM_TIMEOUT_SECONDS=45
LLM_MAX_CALLS_PER_RUN=20
LLM_MAX_BUDGET_PER_RUN_USD=0.10

# ============================================================================
# Risk Engine Boundaries (SEBI & RBI Regulatory Constraints)
# ============================================================================
ARTHAAI_RISK_MAX_DAILY_LOSS_PCT=0.02
ARTHAAI_RISK_MAX_SINGLE_STOCK_EXPOSURE_PCT=0.05
ARTHAAI_RISK_FNO_BAN_ENFORCED=true
ARTHAAI_RISK_CIRCUIT_BREAKERS_ENFORCED=true
