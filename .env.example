# ArthaAI Environment Configuration Example
# Copy this file to .env and replace with local development values

# Environment: development | test | research | paper
ARTHAAI_ENVIRONMENT=development
ARTHAAI_LIVE_TRADING_ENABLED=false
ARTHAAI_DATA_DIR=datasets
ARTHAAI_LOG_LEVEL=INFO

# Research API & Web Interface Configuration
ARTHAAI_API_HOST=127.0.0.1
ARTHAAI_API_PORT=8000
VITE_API_URL=http://127.0.0.1:8000

# PostgreSQL Configuration
ARTHAAI_DB_HOST=localhost
ARTHAAI_DB_PORT=5432
ARTHAAI_DB_NAME=arthaai
ARTHAAI_DB_USER=postgres
ARTHAAI_DB_PASSWORD=your_secure_password_here

# Redis Configuration
ARTHAAI_REDIS_HOST=localhost
ARTHAAI_REDIS_PORT=6379
ARTHAAI_REDIS_DB=0
ARTHAAI_REDIS_PASSWORD=

# Risk Management Configuration
ARTHAAI_RISK_MAX_DAILY_LOSS_PCT=0.02
ARTHAAI_RISK_MAX_SINGLE_STOCK_EXPOSURE_PCT=0.05
ARTHAAI_RISK_FNO_BAN_ENFORCED=true
ARTHAAI_RISK_CIRCUIT_BREAKERS_ENFORCED=true
