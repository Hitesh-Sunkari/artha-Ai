# ============================================================================
# ArthaAI Production Backend Container
# ============================================================================
FROM python:3.12-slim AS runtime

# Prevent Python from writing .pyc files and buffer stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app/src" \
    ARTHAAI_DATA_DIR="/app/data" \
    ARTHAAI_ENVIRONMENT="production" \
    ARTHAAI_LIVE_TRADING_ENABLED="false" \
    PORT=8000

WORKDIR /app

# Install system utilities needed for health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged application user
RUN groupadd -g 1000 appuser && \
    useradd -u 1000 -g appuser -s /bin/bash -m appuser

# Copy dependency manifests and install Python packages
COPY pyproject.toml /app/
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
    "fastapi>=0.112.0" \
    "uvicorn[standard]>=0.30.0" \
    "pydantic>=2.12.0" \
    "pydantic-settings>=2.2.0" \
    "duckdb>=1.0.0" \
    "pyarrow>=16.0.0" \
    "chromadb>=0.5.0" \
    "mcp>=1.2.0" \
    "a2a-sdk>=0.3.4" \
    "google-adk>=2.13.0" \
    "crewai>=1.15.0" \
    "httpx>=0.27.0" \
    "numpy>=1.26.0" \
    "pandas>=2.2.0" \
    "scipy>=1.13.0" \
    "yfinance>=0.2.40" \
    "python-dotenv>=1.0.0"

# Install package in editable or standard mode
COPY src/ /app/src/
RUN pip install --no-cache-dir -e /app

# Copy analytical datasets and ChromaDB vector corpus
COPY data/ /app/data/
COPY configs/ /app/configs/

# Ensure directories exist and permissions are granted to non-root user
RUN mkdir -p /app/data/runs /app/data/blackboard /app/data/quality /app/data/quarantine && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "arthaai.api.research_api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--limit-concurrency", "10"]

